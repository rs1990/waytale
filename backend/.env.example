DATABASE_URL=postgresql://waytale:waytale_dev@localhost:5432/waytale
REDIS_URL=redis://localhost:6379
PORT=3001
NODE_ENV=development
ADMIN_API_KEY=change_me_before_production
# Directory the pipeline writes synthesized audio to (pipeline/.env: AUDIO_OUTPUT_DIR).
# Served statically at /audio. Defaults to ../pipeline/audio_cache relative to backend/.
AUDIO_DIR=../pipeline/audio_cache
# Comma-separated list of extra allowed CORS origins (localhost/Expo dev origins are always allowed)
ALLOWED_ORIGINS=
# JWT signing secret for auth scaffold (backend/src/routes/auth.js) — set a real random value
JWT_SECRET=change_me_before_production
